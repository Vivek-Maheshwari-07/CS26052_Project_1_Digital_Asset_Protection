# ---- Database ----
MONGO_URI=mongodb://localhost:27017
MONGO_DB=digital_asset

# ---- Auth ----
JWT_SECRET=generate-a-long-random-string

# ---- Email (OTP delivery) ----
# Leave SMTP_HOST empty to print OTP codes in the backend console (dev mode).
# Gmail: enable 2-Step Verification, create an App Password at
# https://myaccount.google.com/apppasswords and paste it below (no spaces).
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Provenance

FRONTEND_ORIGIN=http://localhost:5173

# ---- Booth mode (exhibitions such as MakerFest) ----
# Visitors open /booth, get a guest session with no sign-up, and check images against the works
# registered by this account. Register the gallery from that account first.
# End of day: python -m app.booth_reset   (deletes guests and their uploads)
BOOTH_MODE=false
BOOTH_GALLERY_USERNAME=
